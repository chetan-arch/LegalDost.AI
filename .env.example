# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.

ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/legaldost.db
# PostgreSQL + pgvector (docker compose):
# DATABASE_URL=postgresql+psycopg://legaldost:change-me@127.0.0.1:5432/legaldost

# Long random value; used to pseudonymise phone numbers (HMAC). Changing it orphans conversations.
USER_ID_HASH_SECRET=replace-with-64-random-characters

# --- WhatsApp Cloud API (Meta) -----------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0   # check Meta's changelog for the current version
WHATSAPP_ALLOW_UNSIGNED_DEV=false  # only honoured when ENVIRONMENT=development

# --- Admin API (disabled when empty) -----------------------------------------------------------
ADMIN_API_TOKEN=

# --- LLM (none = extractive mode: quotes only, no interpretation) ------------------------------
LLM_PROVIDER=none                  # none | anthropic | ollama
# Free local model via Ollama (https://ollama.com). Install it, then: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
LLM_MODEL_STANDARD=claude-opus-5-5
LLM_EFFORT_STANDARD=low
LLM_MODEL_DEEP=claude-opus-5-5
LLM_EFFORT_DEEP=high
LLM_MODEL_ROUTER=claude-haiku-5-5
LLM_REFUSAL_FALLBACK=true
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_QUESTION=3
LLM_MONTHLY_BUDGET_USD=25

# --- Decision engine ---------------------------------------------------------------------------
DECISION_ENGINE=rules              # rules | jev | llm
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MIN_CONFIDENCE=0.6

# --- Retrieval ---------------------------------------------------------------------------------
EMBEDDING_BACKEND=hashing          # hashing | sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=256                  # must match the model; run `legaldost reindex-embeddings` after changing
RETRIEVAL_MAX_PASSAGES=6

# --- Ingestion ---------------------------------------------------------------------------------
INGEST_MAX_FILE_MB=25
INGEST_REQUEST_INTERVAL_SECONDS=2
KEEP_RAW_SOURCE_FILES=true

# --- Privacy / abuse ---------------------------------------------------------------------------
CONVERSATION_RETENTION_HOURS=72
RATE_LIMIT_MESSAGES_PER_HOUR=30
MAX_MESSAGE_CHARS=2000
